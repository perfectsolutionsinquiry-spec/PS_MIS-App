# Copy to .env.local for local development (Vite convention). Never commit
# the real .env.local — see .gitignore.

# From your Clerk dashboard (API Keys page) — starts with pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=

# Where the API is deployed, e.g. https://perfect4developers.onrender.com
VITE_API_URL=http://localhost:3000
