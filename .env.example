# Copy to .env and fill in for local development.
# Never commit the real .env file — it's already in .gitignore.

# ------------------- DATABASE -------------------------------------------------
# Postgres connection string. Any Postgres works — Neon, Supabase, Render,
# Railway, or a local/self-hosted Postgres (Docker, system install).
# Until this is set, the API runs in "no database" mode — /health still works,
# /db-check reports it's unset.
DATABASE_URL=

# ------------------- SERVER ---------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins (CORS). Defaults to allow-all.
FRONTEND_ORIGIN=

# ------------------- AUTH -----------------------------------------------------
# Which auth provider the API uses. "clerk" (default) or "local".
AUTH_PROVIDER=clerk
# When AUTH_PROVIDER=clerk — the API-side secret for verifying Clerk tokens.
CLERK_SECRET_KEY=
# When AUTH_PROVIDER=local — signs our own JWTs. Generate:
#   openssl rand -base64 32
LOCAL_AUTH_SECRET=
# How long a local-auth session token stays valid in seconds (default 86400 = 24h).
LOCAL_AUTH_TOKEN_TTL_SECONDS=86400

# ------------------- FRONTEND (VITE_-prefixed, baked in at build time) --------
# URL of the API from the browser's point of view.
VITE_API_URL=
# Which auth provider the frontend uses: "clerk" (default) or "local".
VITE_AUTH_PROVIDER=clerk
# When VITE_AUTH_PROVIDER=clerk — Clerk's publishable key.
VITE_CLERK_PUBLISHABLE_KEY=
