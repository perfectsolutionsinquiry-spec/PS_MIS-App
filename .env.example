# Copy to .env and fill in for local development.
# Never commit the real .env file — it's already in .gitignore.

# Postgres connection string for a real database (e.g. free tier on Neon, Supabase, or Render).
# Until this is set, the API runs in "no database" mode — /health still works, /db-check reports it's unset.
DATABASE_URL=

PORT=3000
